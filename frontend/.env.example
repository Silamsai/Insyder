# Insyder portal (the login app, repo: insyder-portal)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Public address of this site (canonical links, sitemap, social previews). Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only (no NEXT_PUBLIC_ prefix): used by /api/demo-requests to forward
# "Book a demo" requests to the portal's API (Platform HQ -> Demo requests).
PORTAL_API_URL=http://localhost:4000
# Must match DEMO_INTAKE_KEY in the portal's backend/.env
DEMO_INTAKE_KEY=

# Pricing is hidden for demos. "true" shows the Pricing page, nav links and paid sign-up again.
NEXT_PUBLIC_SHOW_PRICING=false
